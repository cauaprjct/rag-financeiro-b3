# Credenciais de LLM (forneça pelo menos uma)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Parâmetros de chunking e recuperação (opcionais; valores = padrão)
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small

# Reranking opcional (desligado por padrão; use GPU apenas no desenvolvimento)
RERANK_ENABLED=false
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES_N=20
DEVICE=auto
